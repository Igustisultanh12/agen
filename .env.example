APP_NAME="AI Coding Workspace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (MySQL 8+ Recommended, SQLite supported)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fcc_workspace
DB_USERNAME=root
DB_PASSWORD=

# Cache, Queue & Session
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis Configuration (Optional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Free Claude Code (FCC) Engine Integration (Requirement 56)
# Default FCC proxy server URL and authentication bearer token
FCC_BASE_URL=http://127.0.0.1:8082
FCC_AUTH_TOKEN=freecc
FCC_TIMEOUT=120
FCC_CONNECT_TIMEOUT=10

# Default Platform Administrator Setup (Requirement 54)
ADMIN_NAME="Platform Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password_123

# Google OAuth (Optional - Requirement 53)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail Configuration (Requirement 52)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@fcc-workspace.local"
MAIL_FROM_NAME="${APP_NAME}"

# Custom Encryption Key (Optional)
ENCRYPTION_KEY=
